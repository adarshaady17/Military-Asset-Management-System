{
  "name": "mams-asset-api",
  "version": "1.0.0",
  "private": true,
  "description": "Military asset management REST API",
  "main": "src/app.js",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "start": "node src/app.js",
    "dev": "nodemon src/app.js",
    "db:migrate": "node src/database/migrate.js",
    "db:setup": "node src/database/migrate.js && node src/utils/seedDemoData.js",
    "seed:admin": "node src/utils/seedAdmin.js",
    "seed:demo": "node src/utils/seedDemoData.js",
    "check": "node --check src/app.js && node --check src/database/postgres.js"
  },
  "allowScripts": {
    "bcrypt@6.0.0": true
  },
  "type": "commonjs",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.4",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  }
}
